# ════════════════════════════════════════════════════════════
#  Material Master Portal — Environment Variables Template
#  Copy this file to: backend/.env  and fill in real values
#  NEVER commit .env to GitHub!
# ════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend URL — used in all email links
FRONTEND_URL=http://localhost:5173

# ── SMTP (Gmail) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail account that SENDS emails (IT Admin inbox)
EMAIL_USER=tanviraul196@gmail.com

# Gmail App Password — NOT your normal Gmail password
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_app_password_here

# ── Test Email Routing ─────────────────────────────────────
# All emails are redirected to these inboxes during testing
TEST_USER_EMAIL=raulankesh96@gmail.com
TEST_ADMIN_EMAIL=tanviraul196@gmail.com
